{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "/usr/local/bin/daguard --adapter cursor --event pre-tool --managed --policy /etc/daguard/policy.json",
        "matcher": "*",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "/usr/local/bin/daguard --adapter cursor --event post-tool --managed --policy /etc/daguard/policy.json",
        "matcher": "*",
        "timeout": 5,
        "failClosed": true
      }
    ]
  }
}
