{
  "description": "Drupal Agent Guard pre-execution enforcement and metadata-only session taint observation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/daguard --adapter codex --event pre-tool --managed --policy /etc/daguard/policy.json",
            "timeout": 5,
            "statusMessage": "Checking organization security policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/daguard --adapter codex --event post-tool --managed --policy /etc/daguard/policy.json",
            "timeout": 5,
            "statusMessage": "Recording security classifications"
          }
        ]
      }
    ]
  }
}
